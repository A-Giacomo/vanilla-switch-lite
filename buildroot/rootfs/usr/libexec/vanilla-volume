#!/bin/sh

case "$1" in
    up)
        amixer -q sset 'x Speaker' 5%+ unmute
        ;;
    down)
        amixer -q sset 'x Speaker' 5%-
        ;;
    *)
        exit 2
        ;;
esac

# Print the resulting volume (just the percentage) so Vanilla can show it on
# screen. Prints nothing if the mixer control can't be read.
amixer sget 'x Speaker' 2>/dev/null | sed -n 's/.*\[\([0-9]\{1,3\}\)%\].*/\1/p' | head -n 1
